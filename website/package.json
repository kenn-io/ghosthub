{
  "name": "ghosthub-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/sync-assets.sh && bash scripts/build-docs.sh && astro dev",
    "build": "bash scripts/sync-assets.sh && bash scripts/build-docs.sh && astro build",
    "preview": "astro preview",
    "check": "bash scripts/sync-assets.sh && astro check",
    "lint": "oxlint src browser-tests playwright.config.ts",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "astro": "7.1.3",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "oxlint": "1.74.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
