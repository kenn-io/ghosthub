{
  "name": "ghosthub-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/sync-assets.sh && bash scripts/build-docs.sh && astro dev",
    "build": "bash scripts/sync-assets.sh && bash scripts/build-docs.sh && astro build",
    "preview": "astro preview",
    "check": "bash scripts/sync-assets.sh && astro check",
    "lint": "oxlint src browser-tests playwright.config.ts",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "astro": "7.4.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "oxlint": "1.74.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
