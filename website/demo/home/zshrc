# Minimal interactive prompt for demo tmux panes. Keeps personal shell
# config (and anything it embeds, like hostnames) out of screenshots.
autoload -Uz vcs_info
precmd() { vcs_info }
zstyle ':vcs_info:git:*' formats '%F{magenta}%b%f '
setopt PROMPT_SUBST
PROMPT='%F{cyan}%1~%f ${vcs_info_msg_0_}%F{green}❯%f '
RPROMPT=''
