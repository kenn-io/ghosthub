---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import InstallCommand from '../components/InstallCommand.astro';
import ZoomableImage from '../components/ZoomableImage.astro';
import commandCenter from '../assets/guide-command-center.png';
import hosts from '../assets/guide-hosts.png';
import nativeTabs from '../assets/guide-native-tabs.png';
import commandPalette from '../assets/guide-quick-launch.png';
import sessionPreviews from '../assets/guide-session-previews.png';
import sessions from '../assets/guide-sessions.png';
import terminal from '../assets/guide-terminal.png';
import worktree from '../assets/guide-worktree.png';
import worktreeChanges from '../assets/guide-worktree-changes.png';
import { RELEASES_URL } from '../config';

const title = 'Ghosthub overview';
const description =
  'How Ghosthub manages local and remote tmux, Herdr, and Zellij sessions, '
  + 'experimental Rex and Herdr Core terminals, SSH reconnects, and Git '
  + 'worktrees without touching a local shell.';

const imageWidths = [640, 960, 1280, 1600];
const imageSizes = '(max-width: 900px) calc(100vw - 3rem), 900px';
const imageAlt = {
  sessions:
    'Ghosthub workspace showing tmux, Herdr, and Zellij sessions for local and remote hosts',
  sessionPreviews:
    'Ghosthub sidebar with Always Live previews expanded for discovered tmux sessions',
  hosts: 'Ghosthub Hosts settings with a configured remote GPU host',
  worktree:
    'Ghosthub new worktree sheet listing available local and remote branches',
  worktreeChanges:
    'Ghosthub sidebar showing staged, modified, and untracked worktree files',
  commandPalette: 'Ghosthub Command Palette filtered to a reconnect worktree',
  commandCenter:
    'Four Ghosthub windows arranged in a tight 2x2 grid, each attached to a different tmux session with its sidebar collapsed',
  nativeTabs:
    'Six numbered native Ghosthub workspace tabs, each attached to a different tmux session',
  terminal:
    'Ghosthub Appearance settings showing the theme for new tmux sessions',
};
---

<SiteLayout title={title} description={description} path="/overview/">
  <section class="intro">
    <div class="container narrow">
      <p class="eyebrow">Five-minute tour</p>
      <h1>Meet Ghosthub</h1>
      <p class="lead">
        Ghosthub is a dedicated Mac app for managing local and remote terminal
        multiplexers. It is an alternative to juggling tmux, Herdr, and Zellij
        sessions inside a general-purpose terminal like iTerm2, Ghostty, or
        Kitty, with experimental support for Rex and Herdr Core.
      </p>
      <p>
        Instead of opening a local shell, typing <code>ssh</code>, listing
        sessions, and reattaching every time Wi-Fi drops, you pick a host and
        session in Ghosthub and land straight inside it. Each multiplexer keeps
        its own panes, history, key bindings, and running programs; Ghosthub
        handles discovery, switching, live previews, and automatic reconnect.
      </p>
      <p class="docs-callout">
        Looking for setup steps or limits? Go to the <a href="/docs/">Docs</a>.
        This tour tracks <code>main</code>, so check{' '}
        <a href="/docs/getting-started/#release-and-nightly-builds">release and nightly builds</a>{' '}
        if a feature is newer than the stable download.
      </p>
      <p class="promise" aria-label="Automatic SSH reconnect plus exact session reattach">
        <span class="promise-icon" aria-hidden="true">↻</span>
        <span>Automatic SSH reconnect</span>
        <i aria-hidden="true">+</i>
        <span>Exact session reattach</span>
      </p>
      <div class="requirements" aria-label="Requirements">
        <span>Apple Silicon</span>
        <span>macOS 15+</span>
        <span>tmux 3.2+, Herdr 0.8+, or Zellij 0.44+</span>
        <span>Experimental: Rex &amp; Herdr Core</span>
      </div>
      <InstallCommand />
    </div>
  </section>

  <nav class="contents container" aria-label="On this page">
    <a href="#sessions"><b>01</b> Sessions</a>
    <a href="#session-previews"><b>02</b> Previews</a>
    <a href="#hosts"><b>03</b> Mac and SSH</a>
    <a href="#worktrees"><b>04</b> Worktrees</a>
    <a href="#command-palette"><b>05</b> Quick jump</a>
    <a href="#command-center"><b>06</b> Windows &amp; tabs</a>
    <a href="#terminal"><b>07</b> Terminal setup</a>
  </nav>

  <ol class="steps">
    <li id="sessions">
      <div class="container step-copy">
        <p class="number">01</p>
        <div>
          <h2>Every host and session in one sidebar</h2>
          <p>
            Ghosthub connects to your Mac and remote hosts and lists every tmux,
            Herdr, and Zellij session in one sidebar, along with experimental
            support for Rex windows and Herdr Core terminals and any registered
            Git projects and worktrees. Click a session to attach straight to
            it, or click the plus button next to a host to create one, with no
            local shell needed.
          </p>
          <p>
            Sessions started elsewhere by a shell or a coding agent show up
            automatically. Closing a view only detaches; your programs keep
            running until you confirm a kill or stop action.
            <a href="/docs/sessions/">How sessions work</a>.
          </p>
        </div>
      </div>
      <figure class="container window">
        <ZoomableImage label={imageAlt.sessions}>
          <Image
            src={sessions}
            alt={imageAlt.sessions}
            widths={imageWidths}
            sizes={imageSizes}
            loading="eager"
          />
        </ZoomableImage>
      </figure>
    </li>

    <li id="session-previews">
      <div class="container step-copy">
        <p class="number">02</p>
        <div>
          <h2>Check on tmux sessions without switching</h2>
          <p>
            Expand a preview in the sidebar to see what a tmux session is doing
            without leaving your current window. Efficient mode keeps a
            snapshot. Live mode refreshes up to four inactive previews. Always
            Live connects automatically to discovered tmux sessions on macOS and
            Linux hosts so every preview stays current; it needs tmux 3.4+ and
            uses more CPU, memory, and SSH connections.
          </p>
          <p><a href="/docs/sessions/#preview-opened-tmux-sessions">Read about preview modes</a>.</p>
        </div>
      </div>
      <figure class="container window">
        <ZoomableImage label={imageAlt.sessionPreviews}>
          <Image
            src={sessionPreviews}
            alt={imageAlt.sessionPreviews}
            widths={imageWidths}
            sizes={imageSizes}
          />
        </ZoomableImage>
      </figure>
    </li>

    <li id="hosts">
      <div class="container step-copy">
        <p class="number">03</p>
        <div>
          <h2>Manage remote SSH hosts alongside your Mac</h2>
          <p>
            Add a remote machine by SSH address or an alias from your OpenSSH
            config, or discover running exe.dev VMs. Ghosthub manages the SSH
            connection for you, surfaces host-key checks and login prompts when
            needed, and reconnects straight back into your exact session after
            ordinary network drops.
          </p>
          <p>
            Drag hosts in the sidebar or reorder them in Settings; both share
            the same saved order. See <a href="/docs/remote-hosts/#reorder-hosts">Reorder hosts</a>.
          </p>
          <p>
            Turn <a href="/docs/remote-hosts/#ssh-agent-forwarding">SSH agent forwarding</a>
            on or off per host in Settings, or defer to your OpenSSH config.
          </p>
          <p><a href="/docs/remote-hosts/">Set up remote hosts</a>.</p>
        </div>
      </div>
      <figure class="container window">
        <ZoomableImage label={imageAlt.hosts}>
          <Image
            src={hosts}
            alt={imageAlt.hosts}
            widths={imageWidths}
            sizes={imageSizes}
          />
        </ZoomableImage>
      </figure>
    </li>

    <li id="worktrees">
      <div class="container step-copy">
        <p class="number">04</p>
        <div>
          <h2>Spin up Git worktrees from the sidebar</h2>
          <p>
            Register a repository on any host to create tmux-backed worktrees
            from branches or GitHub pull requests without running
            <code>git worktree</code> by hand. Each worktree row shows its open
            tmux window count, and native tabs show the project and worktree
            name. Git is optional if you only manage standalone sessions.
          </p>
          <p>
            Importing a pull request requires Git 2.42+ and the GitHub CLI on
            the Mac or Linux host that holds the repository.
          </p>
          <p>
            Expand a worktree to inspect staged, modified, and untracked files
            without opening a shell. Right-click a project and choose
            <strong>Open All Worktrees as Tabs</strong> to open the whole
            repository at once, or use <strong>Flag Worktree</strong> to mark
            work to come back to.
          </p>
          <p><a href="/docs/projects-worktrees/">Projects and worktrees guide</a>.</p>
        </div>
      </div>
      <figure class="container window">
        <ZoomableImage label={imageAlt.worktree}>
          <Image
            src={worktree}
            alt={imageAlt.worktree}
            widths={imageWidths}
            sizes={imageSizes}
          />
        </ZoomableImage>
      </figure>
      <figure class="container window">
        <ZoomableImage label={imageAlt.worktreeChanges}>
          <Image
            src={worktreeChanges}
            alt={imageAlt.worktreeChanges}
            widths={imageWidths}
            sizes={imageSizes}
          />
        </ZoomableImage>
      </figure>
    </li>

    <li id="command-palette">
      <div class="container step-copy">
        <p class="number">05</p>
        <div>
          <h2>Jump anywhere from the keyboard</h2>
          <p>
            Press <code>Command-Shift-P</code> to open the Command Palette and
            switch directly to any session, host, project, worktree, setting, or
            action without touching a shell or clicking through the sidebar.
          </p>
          <p><a href="/docs/keyboard-shortcuts/">See all keyboard shortcuts</a>.</p>
        </div>
      </div>
      <figure class="container window">
        <ZoomableImage label={imageAlt.commandPalette}>
          <Image
            src={commandPalette}
            alt={imageAlt.commandPalette}
            widths={imageWidths}
            sizes={imageSizes}
          />
        </ZoomableImage>
      </figure>
    </li>

    <li id="command-center">
      <div class="container step-copy">
        <p class="number">06</p>
        <div>
          <h2>Organize sessions in native windows and tabs</h2>
          <p>
            Open different local or remote sessions in independent Mac windows
            or native tabs, then collapse the sidebar when you want the attached
            session to fill the frame. Jump directly between tabs with
            Command-1 through Command-8, or Command-9 for the last tab.
          </p>
          <p>
            Name a window with <strong>Window → Rename Window…</strong> and
            Ghosthub restores the name across relaunches. Command-W closes the
            current view and detaches without stopping the session;
            Shift-Command-W closes the whole window.
          </p>
          <p><a href="/docs/windows-navigation/">Windows and navigation guide</a>.</p>
        </div>
      </div>
      <figure class="container command-matrix">
        <ZoomableImage label={imageAlt.commandCenter}>
          <Image
            src={commandCenter}
            alt={imageAlt.commandCenter}
            widths={[640, 960, 1280, 1800]}
            sizes="(max-width: 1200px) calc(100vw - 3rem), 1160px"
          />
        </ZoomableImage>
      </figure>
      <figure class="container window">
        <ZoomableImage label={imageAlt.nativeTabs}>
          <Image
            src={nativeTabs}
            alt={imageAlt.nativeTabs}
            widths={imageWidths}
            sizes={imageSizes}
          />
        </ZoomableImage>
      </figure>
    </li>

    <li id="terminal">
      <div class="container step-copy">
        <p class="number">07</p>
        <div>
          <h2>libghostty rendering with your own config</h2>
          <p>
            Ghosthub uses libghostty 1.4.0 to render each attached session with
            GPU acceleration while keeping its settings separate from
            Ghostty.app. Set fonts, colors, background opacity, and blur in
            Ghosthub's own <code>ghostty.conf</code>, and pick a default theme
            for new tmux sessions in Settings.
          </p>
          <p><a href="/docs/terminal-configuration/">Terminal configuration guide</a>.</p>
        </div>
      </div>
      <figure class="container window">
        <ZoomableImage label={imageAlt.terminal}>
          <Image
            src={terminal}
            alt={imageAlt.terminal}
            widths={imageWidths}
            sizes={imageSizes}
          />
        </ZoomableImage>
      </figure>
    </li>
  </ol>

  <section class="finish">
    <div class="container narrow">
      <p class="eyebrow">No lock-in</p>
      <h2>Ordinary multiplexers underneath</h2>
      <p>
        Ghosthub manages access to your tmux, Herdr, and Zellij sessions, plus
        experimental Rex windows and Herdr Core terminals, without taking them
        over. They keep running when Ghosthub is closed and stay reachable from
        their own CLI clients.
      </p>
      <a data-download href={RELEASES_URL}>Download Ghosthub <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>
</SiteLayout>

<style>
  .intro {
    padding: 5rem 0 3.5rem;
    text-align: center;
    background:
      radial-gradient(
        52% 70% at 50% 0%,
        color-mix(in srgb, var(--accent) 8%, transparent),
        transparent
      );
  }

  .narrow {
    max-width: 760px;
  }

  .eyebrow,
  .number {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
  }

  h1 {
    font-size: clamp(2.3rem, 6vw, 4.2rem);
  }

  .lead {
    color: var(--text-dim);
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    margin: 1rem auto 0;
    max-width: 64ch;
    text-wrap: balance;
  }

  .docs-callout {
    color: var(--text-dim);
    margin: 1rem 0 0;
  }

  .docs-callout a {
    color: var(--accent);
  }

  .promise {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem;
    max-width: calc(100% - 1rem);
    margin: 1.4rem 0 0;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--line));
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.45rem 0.75rem;
  }

  .promise-icon {
    color: var(--accent);
    font-size: 1rem;
  }

  .promise i {
    color: var(--text-faint);
    font-style: normal;
  }

  .requirements {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem;
    margin: 1.6rem 0;
  }

  .requirements span {
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.3rem 0.7rem;
  }

  .finish a {
    display: inline-block;
    border-radius: 10px;
    background: var(--accent);
    color: #06222e;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.75rem 1.15rem;
  }

  .contents {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .contents a {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 1rem;
    text-align: center;
    transition: background 0.15s, color 0.15s;
  }

  .contents a + a {
    border-left: 1px solid var(--line);
  }

  .contents a:hover {
    background: var(--bg-raise);
    color: var(--text);
  }

  .contents b {
    color: var(--accent);
    display: block;
    font-size: 0.68rem;
    margin-bottom: 0.2rem;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .steps > li {
    border-top: 1px solid var(--line);
    padding: 5rem 0 6rem;
    scroll-margin-top: 4rem;
  }

  .steps > li:nth-child(even) {
    background: var(--bg-raise);
  }

  .step-copy {
    display: grid;
    grid-template-columns: 5rem minmax(0, 660px);
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .number {
    margin: 0.25rem 0 0;
  }

  h2 {
    font-size: clamp(1.55rem, 3.5vw, 2.25rem);
  }

  .step-copy p:not(.number),
  .finish p:not(.eyebrow) {
    color: var(--text-dim);
  }

  .step-copy p {
    margin: 0.85rem 0 0;
  }

  .step-copy strong {
    color: var(--text);
  }

  .reconnect {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.8rem;
    margin-top: 1.4rem;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 6%, var(--bg));
    padding: 1rem;
  }

  .reconnect > span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .reconnect p {
    margin: 0;
  }

  .step-copy a {
    color: var(--accent);
  }

  code,
  kbd {
    border: 1px solid var(--line);
    border-radius: 5px;
    background: color-mix(in srgb, var(--bg) 75%, transparent);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.84em;
    padding: 0.12rem 0.34rem;
  }

  .shortcuts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1rem;
    margin-top: 1.25rem;
  }

  .shortcuts span {
    color: var(--text-dim);
    font-size: 0.82rem;
  }

  .window {
    max-width: 920px;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg);
    box-shadow: 0 28px 70px rgb(0 0 0 / 0.4);
  }

  .window :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .command-matrix {
    max-width: 1180px;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg);
    box-shadow: 0 28px 70px rgb(0 0 0 / 0.45);
  }

  .command-matrix :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .finish {
    border-top: 1px solid var(--line);
    padding: 5rem 0 6rem;
    text-align: center;
  }

  .finish p:not(.eyebrow) {
    margin: 1rem auto 1.6rem;
    max-width: 58ch;
  }

  @media (max-width: 760px) {
    .intro {
      padding-top: 3.5rem;
    }

    .contents {
      grid-template-columns: 1fr;
    }

    .contents a {
      display: flex;
      gap: 0.65rem;
      text-align: left;
    }

    .contents b {
      margin: 0;
    }

    .contents a + a {
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .steps > li {
      padding: 3.5rem 0 4rem;
    }

    .step-copy {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

  }
</style>
