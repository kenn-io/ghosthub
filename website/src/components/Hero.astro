---
import { Image } from 'astro:assets';
import { GITHUB_URL } from '../config';
import AppIcon from './AppIcon.astro';
import InstallCommand from './InstallCommand.astro';
import ZoomableImage from './ZoomableImage.astro';
import hero from '../assets/hero.png';

const heroAlt =
  'Ghosthub main window: sidebar with local and remote tmux sessions and kwt '
  + 'worktrees, and an attached session running a Claude Code investigation';
---

<section class="hero">
  <div class="container">
    <p class="lockup">
      <AppIcon prefix="gh-ic-hero" />
      <span class="wordmark">Ghosthub</span>
    </p>
    <h1>A native power terminal for your tmux fleet</h1>
    <p class="sub">
      Create or attach to any tmux session on your Mac or over SSH, or manage
      worktree-bound sessions from Git branches and GitHub pull requests, with
      keepalives and automatic reconnect.
    </p>
    <div class="install-action">
      <InstallCommand />
    </div>
    <p class="meta">
      <span data-version></span>macOS 26+ &middot; Apple Silicon
      {' '}<span aria-hidden="true">&middot;</span>{' '}
      <a href={GITHUB_URL}>View on GitHub</a>
    </p>
    <figure class="window">
      <ZoomableImage label={heroAlt}>
        <Image
          src={hero}
          alt={heroAlt}
          widths={[640, 960, 1280, 1920, 2400]}
          sizes="(max-width: 1000px) 100vw, 960px"
          loading="eager"
          fetchpriority="high"
        />
      </ZoomableImage>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: 2.75rem 0 3rem;
    text-align: center;
    background:
      radial-gradient(
        60% 40% at 50% 0%,
        color-mix(in srgb, var(--accent) 7%, transparent),
        transparent
      );
  }

  .lockup {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    margin: 0 0 1.4rem;
  }

  .lockup :global(svg) {
    width: 58px;
    height: 58px;
    filter:
      drop-shadow(0 10px 24px rgb(0 0 0 / 0.5))
      drop-shadow(0 0 30px color-mix(in srgb, var(--accent) 25%, transparent));
  }

  .wordmark {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(1.8rem, 4vw, 2.3rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  h1 {
    font-size: clamp(1.9rem, 4.4vw, 2.9rem);
    max-width: 26ch;
    margin-inline: auto;
    text-wrap: balance;
  }

  .sub {
    color: var(--text-dim);
    max-width: 60ch;
    margin: 0.9rem auto 1.6rem;
  }

  .install-action {
    max-width: 100%;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
    margin-top: 1rem;
  }

  .meta a {
    color: var(--text-faint);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--text-faint) 55%, transparent);
    text-underline-offset: 0.2em;
    transition: color 0.15s;
  }

  .meta a:hover {
    color: var(--text-dim);
  }

  .window {
    margin: 3.5rem auto 0;
    max-width: 960px;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-raise);
    box-shadow:
      0 40px 90px rgb(0 0 0 / 0.55),
      0 0 80px color-mix(in srgb, var(--accent) 6%, transparent);
  }

  .window :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lockup,
    h1,
    .sub,
    .install-action,
    .meta,
    .window {
      animation: rise 0.55s cubic-bezier(0.2, 0.7, 0.3, 1) both;
    }

    h1 {
      animation-delay: 0.08s;
    }

    .sub {
      animation-delay: 0.14s;
    }

    .install-action {
      animation-delay: 0.2s;
    }

    .meta {
      animation-delay: 0.24s;
    }

    .window {
      animation-delay: 0.3s;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
