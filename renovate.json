{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "addLabels": ["dependencies"],
  "extends": ["config:recommended", "schedule:weekly", "github>kenn-io/actions//renovate/release-age"],
  "timezone": "America/New_York",
  "osvVulnerabilityAlerts": true,
  "prCreation": "not-pending",
  "constraints": {
    "ghActionsLock": "v0.3.0"
  },
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies",
      "groupSlug": "go-dependencies",
      "postUpdateOptions": ["gomodUpdateImportPaths", "gomodTidy"]
    },
    {
      "matchManagers": ["cargo"],
      "groupName": "Rust dependencies",
      "groupSlug": "rust-dependencies"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "JavaScript dependencies",
      "groupSlug": "javascript-dependencies"
    },
    {
      "matchManagers": ["pep621"],
      "groupName": "Python dependencies",
      "groupSlug": "python-dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "matchManagers": ["docker-compose", "dockerfile"],
      "groupName": "Docker images",
      "groupSlug": "docker-images"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "Developer tools",
      "groupSlug": "dev-tools"
    },
    {
      "description": ["Group kenn-io releases. The shared release-age preset lets them skip the wait and the weekly window."],
      "matchPackageNames": ["kenn-io/**", "github.com/kenn-io/**", "go.kenn.io/**", "@kenn-io/**"],
      "groupName": "kenn-io dependencies",
      "groupSlug": "kenn-io-dependencies"
    }
  ]
}
